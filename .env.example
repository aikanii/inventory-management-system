# Copy to .env and fill in. The app boots without any of these — it then runs
# on its embedded PostgreSQL with a freshly generated JWT key pair.

# Use a real PostgreSQL server instead of the embedded one.
# DATABASE_URL=postgresql://ims:secret@localhost:5432/ims

# Where the embedded database lives (default: ./.ims-data).
# IMS_DATA_DIR=./.ims-data

# Port for `ims start` (default 3000).
# PORT=3000

# Assistant provider reported by /api/v1/meta. "local" is the deterministic
# offline provider that ships today; external providers are interface-only.
# AI_PROVIDER=local
# AI_API_KEY=

# Used by docker-compose.yml only.
# POSTGRES_USER=ims
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=ims
